# --- infrastructure ---
NEO4J_PASSWORD=change_me
NEO4J_URI=bolt://neo4j:7687
NEO4J_RO_USER=retrieval_ro
NEO4J_RO_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
MINIO_USER=plantmind
MINIO_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000

# --- LLM tiers (all calls go through plantmind_core.llm) ---
ANTHROPIC_API_KEY=
LLM_CHEAP=claude-haiku-4-5-20251001      # classify, verify, ER adjudication
LLM_MID=claude-sonnet-5                  # text extraction, answering
LLM_VISION=claude-sonnet-5               # P&ID extraction
EMBEDDING_MODEL=                         # e.g. voyage-3 / bge-m3 (local)
EMBEDDING_DIM=1024

# --- pipeline tuning ---
EXTRACTION_BATCH_SIZE=8                  # chunks per LLM call
WRITE_BATCH_SIZE=500                     # records per UNWIND transaction
WRITE_FLUSH_INTERVAL_S=2
ER_COSINE_ACCEPT=0.92
ER_COSINE_LLM_BAND=0.80
PATHRAG_DECAY_ALPHA=0.8
PATHRAG_MAX_HOPS=4
PATHRAG_TOP_PATHS=15
CACHE_SEMANTIC_THRESHOLD=0.95
DENOISE_INTERVAL_S=3600
