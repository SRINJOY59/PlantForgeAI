# Copy to .env and fill in the keys. Every default below works as-is for a
# local run; the only value you MUST provide is OPENROUTER_API_KEY.
#
# The same file serves both run modes: these are localhost URLs for running
# services in your venv, and docker compose overrides them to service names
# automatically when running the full stack in containers.

# --- infrastructure ---
NEO4J_PASSWORD=plantforge_dev
NEO4J_URI=bolt://localhost:7687
NEO4J_RO_USER=retrieval_ro
NEO4J_RO_PASSWORD=plantforge_dev
REDIS_URL=redis://localhost:6379/0
MINIO_USER=plantforge
MINIO_PASSWORD=plantforge_dev
MINIO_ENDPOINT=http://localhost:9000
# the host a BROWSER reaches MinIO on. Presigned URLs are signed with this,
# never rewritten to it afterwards - SigV4 covers the Host header, so a
# post-signing string replace produces SignatureDoesNotMatch.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- LLM via OpenRouter (all calls go through plantmind_core.llm) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CHEAP=qwen/qwen3.6-flash
LLM_MID=deepseek/deepseek-v4-pro
LLM_VISION=qwen/qwen3.7-plus
LLM_MAX_CONCURRENCY=32

# --- embeddings (any OpenAI-compatible /embeddings endpoint) ---
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Leave EMBEDDING_API_KEY empty to reuse OPENROUTER_API_KEY. Keep this comment
# on its own line: the loader keeps everything after '=' as the value, inline
# '# ...' included, so a trailing comment becomes a garbage API key.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# must match the model's output AND the neo4j vector index dimension
EMBEDDING_DIM=1536

# --- pipeline tuning ---
EXTRACTION_BATCH_SIZE=8
WRITE_BATCH_SIZE=500
WRITE_FLUSH_INTERVAL_S=2
ER_COSINE_ACCEPT=0.92
ER_COSINE_LLM_BAND=0.80
PATHRAG_DECAY_ALPHA=0.8
PATHRAG_MAX_HOPS=4
PATHRAG_TOP_PATHS=15
CACHE_SEMANTIC_THRESHOLD=0.95
DENOISE_INTERVAL_S=3600

# --- knowledge-capture interview service ---
# STT + TTS. Leave empty to run the interview in text-only mode.
DEEPGRAM_API_KEY=
INTERVIEW_TTS_PROVIDER=deepgram

# --- auth (optional) ---
# Unset leaves the gateway OPEN and every user an engineer - correct for a
# local demo, never for a deployment. Set to enable Supabase JWT verification.
SUPABASE_JWT_SECRET=
