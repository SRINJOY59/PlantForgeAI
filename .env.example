# --- infrastructure ---
NEO4J_PASSWORD=change_me
NEO4J_URI=bolt://neo4j:7687
NEO4J_RO_USER=retrieval_ro
NEO4J_RO_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
MINIO_USER=plantmind
MINIO_PASSWORD=change_me
MINIO_ENDPOINT=http://minio:9000

# --- LLM via OpenRouter (all calls go through plantmind_core.llm) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# open-weight tiers (slugs verified against openrouter.ai/api/v1/models)
LLM_CHEAP=qwen/qwen3.6-flash             # classify, verify, ER adjudication
LLM_MID=deepseek/deepseek-v4-pro         # text extraction, answering
LLM_VISION=qwen/qwen3.7-plus             # P&ID extraction; alt: z-ai/glm-5v-turbo
LLM_MAX_CONCURRENCY=32

# --- embeddings (any OpenAI-compatible /embeddings endpoint) ---
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=                       # empty = reuse OPENROUTER_API_KEY
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536   # must match the model's output AND the neo4j vector index

# --- pipeline tuning ---
EXTRACTION_BATCH_SIZE=8                  # chunks per LLM call
WRITE_BATCH_SIZE=500                     # records per UNWIND transaction
WRITE_FLUSH_INTERVAL_S=2
ER_COSINE_ACCEPT=0.92
ER_COSINE_LLM_BAND=0.80
PATHRAG_DECAY_ALPHA=0.8
PATHRAG_MAX_HOPS=4
PATHRAG_TOP_PATHS=15
CACHE_SEMANTIC_THRESHOLD=0.95
DENOISE_INTERVAL_S=3600
